# ── crosschain_arb_v2 — environment template ────────────────────────────
# Copy to `.env` and set TELEGRAM_BOT_TOKEN. Everything else has a working
# default. This bot uses NO paid API keys — all price sources
# (DexScreener, GeckoTerminal, DefiLlama, KyberSwap) are free & keyless.
# Throughput comes from the proxy pool, not API plans.

# Redis — dedicated DB index so keys don't collide with other bots.
REDIS_URL=redis://localhost:6379/1

# Telegram bot token from @BotFather. REQUIRED. Keep secret — your real
# .env is gitignored and must never be committed.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional fixed broadcast chat id. Empty = broadcast to everyone who
# has /start-ed the bot.
TELEGRAM_CHAT_ID=

# Proxy list — one per line: http://user:pass@host:port
# (webshare "host:port:user:pass" lines are auto-normalised on load).
# Gitignored: contains credentials.
PROXIES_FILE=data/proxies.txt

# Misc
LOG_LEVEL=INFO
DRY_RUN=false
